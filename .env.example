# ─── FlyGo environment ─────────────────────────────────────────────
# Copy to .env and replace every <placeholder>. Never commit .env.
# `npm run env:init` generates a .env with random local secrets.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=<min-32-char-random-string>
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=168

# PostgreSQL (existing server; see docs §18)
PG_CONTAINER=empire_db
FLYGO_DB_PASSWORD=<flygo_app-password>
DATABASE_URL=postgresql://flygo_app:<flygo_app-password>@localhost:5432/flygo?schema=public
SHADOW_DATABASE_URL=postgresql://flygo_app:<flygo_app-password>@localhost:5432/flygo_shadow?schema=public

# Redis (sessions, BullMQ, cache, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<redis-password>

# MongoDB (ticket snapshots, email history, notifications)
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<mongo-root-password>
MONGO_APP_USER=flygo_app
MONGO_APP_PASSWORD=<mongo-app-password>
MONGODB_DB=flygo
MONGODB_URI=mongodb://flygo_app:<mongo-app-password>@localhost:27017/flygo?authSource=flygo

# Email (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="FlyGo <no-reply@flygo.local>"

# Booking
HOLD_TTL_SECONDS=600
PAYMENT_HOLD_TTL_SECONDS=900

# Payments (development-only mock provider)
PAYMENTS_PROVIDER=mock
MOCK_PAYMENT_DELAY_MS=1500
