{
  "name": "@flygo/api",
  "version": "0.1.0",
  "private": true,
  "description": "FlyGo API and worker (NestJS modular monolith)",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch --entryFile main",
    "worker:dev": "nest start --watch --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test:int": "jest --config test/jest-integration.config.ts --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "mongodb": "6.21.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.11",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
