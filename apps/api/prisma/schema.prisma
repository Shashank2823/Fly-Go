// FlyGo relational schema — PostgreSQL is the source of truth (docs §6, §7).
// Conventions: snake_case tables/columns via @@map/@map; UUIDv7 primary keys generated by the
// client; timestamptz everywhere; money as BIGINT minor units + CHAR(3) currency.
// CHECK constraints, partial unique indexes and composite FKs that Prisma cannot express are
// added in hand-written migration SQL (docs §6.4) — see prisma/migrations/*_core_schema.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@map("user_status")
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST

  @@map("cabin_class")
}

enum SeatKind {
  STANDARD
  EXTRA_LEGROOM
  EXIT_ROW

  @@map("seat_kind")
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  DEPARTED
  ARRIVED
  CANCELLED

  @@map("flight_status")
}

enum SeatInventoryStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED

  @@map("seat_inv_status")
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED

  @@map("booking_status")
}

enum PassengerType {
  ADULT
  CHILD
  INFANT

  @@map("passenger_type")
}

enum PriceLineKind {
  BASE_FARE
  SEAT_SURCHARGE
  TAX
  FEE
  DISCOUNT

  @@map("price_line_kind")
}

enum FeeRuleKind {
  PERCENT_OF_BASE_BPS
  FIXED_PER_PASSENGER
  SEAT_KIND_SURCHARGE

  @@map("fee_rule_kind")
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentEventSource {
  WEBHOOK
  SIMULATED
  RECONCILIATION

  @@map("payment_event_source")
}

enum PaymentEventStatus {
  RECEIVED
  APPLIED
  IGNORED

  @@map("payment_event_status")
}

enum TicketStatus {
  PENDING
  GENERATING
  ISSUED
  FAILED
  VOIDED

  @@map("ticket_status")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD

  @@map("outbox_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idem_status")
}

enum ActorType {
  USER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

// ───────────────────────── Identity & access ─────────────────────────

/// Authorization roles. Permissions are mapped from roles in code (docs §8.3).
model Role {
  id        Int        @id @db.SmallInt
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(64)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  users     UserRole[]

  @@map("roles")
}

model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  email          String     @unique @db.Citext
  passwordHash   String     @map("password_hash")
  fullName       String     @map("full_name") @db.VarChar(100)
  phone          String?    @db.VarChar(20)
  /// ISO 3166-1 alpha-2; determines the pricing market (docs §23).
  nationality    String     @db.Char(2)
  status         UserStatus @default(ACTIVE)
  /// Bumped on password change / "log out everywhere" to invalidate all sessions.
  sessionVersion Int        @default(1) @map("session_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles               UserRole[]           @relation("UserRoles")
  grantedRoles        UserRole[]           @relation("RoleGrantor")
  bookings            Booking[]
  passwordResetTokens PasswordResetToken[]
  idempotencyKeys     IdempotencyKey[]
  auditLogs           AuditLog[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    Int      @map("role_id") @db.SmallInt
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?  @map("granted_by") @db.Uuid

  user    User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantor User? @relation("RoleGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Designed now, used when password reset is implemented (docs §8.5).
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Markets & pricing rules ─────────────────────────────

model Market {
  code      String   @id @db.VarChar(8)
  name      String   @db.VarChar(64)
  currency  String   @db.Char(3)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  countries MarketCountry[]
  fares     FlightFare[]
  feeRules  FeeRule[]
  bookings  Booking[]

  @@map("markets")
}

/// Nationality → market. Unmapped nationalities use the default market.
model MarketCountry {
  countryCode String @id @map("country_code") @db.Char(2)
  marketCode  String @map("market_code") @db.VarChar(8)

  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@index([marketCode])
  @@map("market_countries")
}

model FeeRule {
  id         String      @id @default(uuid(7)) @db.Uuid
  marketCode String      @map("market_code") @db.VarChar(8)
  code       String      @db.VarChar(32)
  name       String      @db.VarChar(64)
  kind       FeeRuleKind
  /// Required (and only allowed) for SEAT_KIND_SURCHARGE.
  seatKind   SeatKind?   @map("seat_kind")
  /// Basis points for PERCENT_OF_BASE_BPS; minor units otherwise.
  value      BigInt
  activeFrom DateTime    @map("active_from") @db.Timestamptz(6)
  activeTo   DateTime?   @map("active_to") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@unique([marketCode, code, activeFrom])
  @@map("fee_rules")
}

// ───────────────────────────── Reference data ─────────────────────────────

model Airport {
  id          String   @id @default(uuid(7)) @db.Uuid
  iataCode    String   @unique @map("iata_code") @db.Char(3)
  name        String   @db.VarChar(120)
  city        String   @db.VarChar(80)
  countryCode String   @map("country_code") @db.Char(2)
  /// IANA timezone, e.g. Asia/Kolkata.
  timezone    String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  departures Flight[] @relation("FlightOrigin")
  arrivals   Flight[] @relation("FlightDestination")

  @@index([city(ops: raw("gin_trgm_ops"))], map: "airports_city_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "airports_name_trgm_idx", type: Gin)
  @@map("airports")
}

model Airline {
  id        String   @id @default(uuid(7)) @db.Uuid
  iataCode  String   @unique @map("iata_code") @db.Char(2)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  aircraft Aircraft[]
  flights  Flight[]

  @@map("airlines")
}

model AircraftType {
  id           String   @id @default(uuid(7)) @db.Uuid
  manufacturer String   @db.VarChar(40)
  model        String   @unique @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  layouts  SeatLayout[]
  aircraft Aircraft[]

  @@map("aircraft_types")
}

/// Versioned cabin configuration; reconfiguring creates a new version so existing
/// flight inventory is never mutated (docs §6.2).
model SeatLayout {
  id             String   @id @default(uuid(7)) @db.Uuid
  aircraftTypeId String   @map("aircraft_type_id") @db.Uuid
  version        Int
  name           String   @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  aircraftType AircraftType  @relation(fields: [aircraftTypeId], references: [id], onDelete: Restrict)
  cabins       LayoutCabin[]
  seats        LayoutSeat[]
  aircraft     Aircraft[]
  flights      Flight[]

  @@unique([aircraftTypeId, version])
  @@map("seat_layouts")
}

model LayoutCabin {
  id            String     @id @default(uuid(7)) @db.Uuid
  seatLayoutId  String     @map("seat_layout_id") @db.Uuid
  cabin         CabinClass
  firstRow      Int        @map("first_row") @db.SmallInt
  lastRow       Int        @map("last_row") @db.SmallInt
  /// Seat letters left to right; "_" marks an aisle, e.g. "ABC_DEF".
  columnPattern String     @map("column_pattern") @db.VarChar(16)

  seatLayout SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)

  @@unique([seatLayoutId, cabin])
  @@map("layout_cabins")
}

model LayoutSeat {
  id           String     @id @default(uuid(7)) @db.Uuid
  seatLayoutId String     @map("seat_layout_id") @db.Uuid
  rowNumber    Int        @map("row_number") @db.SmallInt
  columnLetter String     @map("column_letter") @db.Char(1)
  cabin        CabinClass
  kind         SeatKind   @default(STANDARD)
  /// e.g. WINDOW, AISLE
  features     String[]   @default([])

  seatLayout  SeatLayout   @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  flightSeats FlightSeat[]

  @@unique([seatLayoutId, rowNumber, columnLetter])
  @@map("layout_seats")
}

model Aircraft {
  id             String   @id @default(uuid(7)) @db.Uuid
  airlineId      String   @map("airline_id") @db.Uuid
  aircraftTypeId String   @map("aircraft_type_id") @db.Uuid
  seatLayoutId   String   @map("seat_layout_id") @db.Uuid
  registration   String   @unique @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  airline      Airline      @relation(fields: [airlineId], references: [id], onDelete: Restrict)
  aircraftType AircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Restrict)
  seatLayout   SeatLayout   @relation(fields: [seatLayoutId], references: [id], onDelete: Restrict)
  flights      Flight[]

  @@map("aircraft")
}

// ───────────────────────────── Flights & inventory ─────────────────────────────

model Flight {
  id                   String       @id @default(uuid(7)) @db.Uuid
  airlineId            String       @map("airline_id") @db.Uuid
  flightNumber         String       @map("flight_number") @db.VarChar(8)
  originAirportId      String       @map("origin_airport_id") @db.Uuid
  destinationAirportId String       @map("destination_airport_id") @db.Uuid
  aircraftId           String       @map("aircraft_id") @db.Uuid
  /// Layout snapshot the inventory was generated from.
  seatLayoutId         String       @map("seat_layout_id") @db.Uuid
  departureAt          DateTime     @map("departure_at") @db.Timestamptz(6)
  arrivalAt            DateTime     @map("arrival_at") @db.Timestamptz(6)
  status               FlightStatus @default(SCHEDULED)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  airline     Airline      @relation(fields: [airlineId], references: [id], onDelete: Restrict)
  origin      Airport      @relation("FlightOrigin", fields: [originAirportId], references: [id], onDelete: Restrict)
  destination Airport      @relation("FlightDestination", fields: [destinationAirportId], references: [id], onDelete: Restrict)
  aircraft    Aircraft     @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  seatLayout  SeatLayout   @relation(fields: [seatLayoutId], references: [id], onDelete: Restrict)
  fares       FlightFare[]
  seats       FlightSeat[]
  bookings    Booking[]

  @@unique([airlineId, flightNumber, departureAt])
  @@map("flights")
}

model FlightFare {
  id            String     @id @default(uuid(7)) @db.Uuid
  flightId      String     @map("flight_id") @db.Uuid
  cabin         CabinClass
  marketCode    String     @map("market_code") @db.VarChar(8)
  baseFareMinor BigInt     @map("base_fare_minor")
  currency      String     @db.Char(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@unique([flightId, cabin, marketCode])
  @@map("flight_fares")
}

/// Per-flight seat inventory and the single authoritative owner of a seat (docs §9).
model FlightSeat {
  id            String              @id @default(uuid(7)) @db.Uuid
  flightId      String              @map("flight_id") @db.Uuid
  layoutSeatId  String              @map("layout_seat_id") @db.Uuid
  seatLabel     String              @map("seat_label") @db.VarChar(4)
  cabin         CabinClass
  kind          SeatKind
  status        SeatInventoryStatus @default(AVAILABLE)
  bookingId     String?             @map("booking_id") @db.Uuid
  holdExpiresAt DateTime?           @map("hold_expires_at") @db.Timestamptz(6)
  version       Int                 @default(0)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  flight       Flight        @relation(fields: [flightId], references: [id], onDelete: Restrict)
  layoutSeat   LayoutSeat    @relation(fields: [layoutSeatId], references: [id], onDelete: Restrict)
  booking      Booking?      @relation("SeatOwner", fields: [bookingId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@unique([flightId, seatLabel])
  @@unique([flightId, layoutSeatId])
  @@unique([id, flightId])
  @@index([flightId, cabin, status])
  @@map("flight_seats")
}

// ───────────────────────────── Bookings ─────────────────────────────

model Booking {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Public 6-char reference (PNR-style). Never authorization on its own.
  reference     String        @unique @db.Char(6)
  userId        String        @map("user_id") @db.Uuid
  flightId      String        @map("flight_id") @db.Uuid
  status        BookingStatus @default(PENDING)
  cabin         CabinClass
  marketCode    String        @map("market_code") @db.VarChar(8)
  currency      String        @db.Char(3)
  adults        Int           @db.SmallInt
  children      Int           @default(0) @db.SmallInt
  infants       Int           @default(0) @db.SmallInt
  seatsRequired Int           @map("seats_required") @db.SmallInt
  holdExpiresAt DateTime?     @map("hold_expires_at") @db.Timestamptz(6)
  contactEmail  String?       @map("contact_email") @db.VarChar(254)
  contactPhone  String?       @map("contact_phone") @db.VarChar(20)
  totalMinor    BigInt?       @map("total_minor")
  priceVersion  Int           @default(0) @map("price_version")
  confirmedAt   DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  expiredAt     DateTime?     @map("expired_at") @db.Timestamptz(6)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  version       Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  flight     Flight             @relation(fields: [flightId], references: [id], onDelete: Restrict)
  market     Market             @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  heldSeats  FlightSeat[]       @relation("SeatOwner")
  passengers BookingPassenger[]
  seats      BookingSeat[]
  priceLines BookingPriceLine[]
  payments   Payment[]
  tickets    Ticket[]

  @@unique([id, flightId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookings")
}

model BookingPassenger {
  id          String        @id @default(uuid(7)) @db.Uuid
  bookingId   String        @map("booking_id") @db.Uuid
  ordinal     Int           @db.SmallInt
  type        PassengerType
  firstName   String        @map("first_name") @db.VarChar(60)
  lastName    String        @map("last_name") @db.VarChar(60)
  dateOfBirth DateTime      @map("date_of_birth") @db.Date
  nationality String?       @db.Char(2)
  email       String?       @db.VarChar(254)
  phone       String?       @db.VarChar(20)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       BookingSeat?
  priceLines BookingPriceLine[]

  @@unique([bookingId, ordinal])
  @@unique([id, bookingId])
  @@map("booking_passengers")
}

/// Passenger ↔ seat assignment within a booking (history). Current ownership lives in
/// flight_seats.booking_id. Composite FKs guarantee seat, booking and flight agree.
model BookingSeat {
  id           String   @id @default(uuid(7)) @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  flightId     String   @map("flight_id") @db.Uuid
  flightSeatId String   @map("flight_seat_id") @db.Uuid
  passengerId  String   @map("passenger_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking    Booking          @relation(fields: [bookingId, flightId], references: [id, flightId], onDelete: Cascade)
  flightSeat FlightSeat       @relation(fields: [flightSeatId, flightId], references: [id, flightId], onDelete: Restrict)
  passenger  BookingPassenger @relation(fields: [passengerId, bookingId], references: [id, bookingId], onDelete: Cascade)

  @@unique([bookingId, flightSeatId])
  @@unique([passengerId, bookingId])
  @@map("booking_seats")
}

model BookingPriceLine {
  id           String        @id @default(uuid(7)) @db.Uuid
  bookingId    String        @map("booking_id") @db.Uuid
  priceVersion Int           @map("price_version")
  kind         PriceLineKind
  code         String        @db.VarChar(32)
  description  String        @db.VarChar(120)
  passengerId  String?       @map("passenger_id") @db.Uuid
  amountMinor  BigInt        @map("amount_minor")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passenger BookingPassenger? @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([bookingId, priceVersion])
  @@map("booking_price_lines")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String        @db.VarChar(32)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(128)
  status            PaymentStatus @default(INITIATED)
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @db.Char(3)
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(64)
  failureCode       String?       @map("failure_code") @db.VarChar(64)
  /// Non-sensitive provider data only — never card data or secrets.
  providerMetadata  Json?         @map("provider_metadata")
  succeededAt       DateTime?     @map("succeeded_at") @db.Timestamptz(6)
  failedAt          DateTime?     @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]

  @@unique([bookingId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([bookingId])
  @@map("payments")
}

/// Durable inbox of provider signals (webhooks, simulated events, reconciliation) (docs §11.3).
model PaymentEvent {
  id                String             @id @default(uuid(7)) @db.Uuid
  provider          String             @db.VarChar(32)
  providerEventId   String             @map("provider_event_id") @db.VarChar(128)
  paymentId         String?            @map("payment_id") @db.Uuid
  type              String             @db.VarChar(64)
  source            PaymentEventSource
  providerCreatedAt DateTime?          @map("provider_created_at") @db.Timestamptz(6)
  payload           Json
  status            PaymentEventStatus @default(RECEIVED)
  ignoreReason      String?            @map("ignore_reason") @db.VarChar(120)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  appliedAt         DateTime?          @map("applied_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// ───────────────────────────── Tickets ─────────────────────────────

model Ticket {
  id           String       @id @default(uuid(7)) @db.Uuid
  bookingId    String       @map("booking_id") @db.Uuid
  version      Int          @default(1)
  ticketNumber String       @unique @map("ticket_number") @db.VarChar(20)
  status       TicketStatus @default(PENDING)
  /// MongoDB ticket_snapshots _id.
  snapshotRef  String?      @map("snapshot_ref") @db.VarChar(64)
  storageKey   String?      @map("storage_key") @db.VarChar(255)
  sha256       String?      @db.Char(64)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error") @db.VarChar(500)
  issuedAt     DateTime?    @map("issued_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, version])
  @@map("tickets")
}

// ───────────────────────────── Reliability & audit ─────────────────────────────

/// Transactional outbox: written in the same transaction as the business change (docs §12.1).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(64)
  eventVersion  Int          @default(1) @map("event_version")
  /// IDs and references only — no PII.
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(500)
  correlationId String?      @map("correlation_id") @db.VarChar(64)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  actorType     ActorType @map("actor_type")
  action        String    @db.VarChar(64)
  entityType    String    @map("entity_type") @db.VarChar(40)
  entityId      String?   @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  correlationId String?   @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  scope          String            @db.VarChar(80)
  key            String            @db.VarChar(64)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime          @map("locked_until") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
